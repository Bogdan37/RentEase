{
  "info": {
    "_postman_id": "qa3-auth-security-9999-8888-7777-666655554444",
    "name": "RentEase - QA3 (Authentication & Authorization Tests)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "user_email",
      "value": "owner.bohdan@example.com",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "temp_property_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. [Auth Negative] Demo Login with Non-Existent Email (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Non-existent user returns 404 Not Found\", function () {",
              "    pm.response.to.have.status(404);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"nonexistent.hacker@rentease.ua\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/Auth/demo-login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "Auth", "demo-login"]
        }
      }
    },
    {
      "name": "2. [Auth Negative] Google OAuth2 with Forged ID Token (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Invalid Google JWT token rejected with 400 Bad Request\", function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idToken\": \"eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.forged_payload.invalid_signature\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/Auth/google",
          "host": ["{{baseUrl}}"],
          "path": ["api", "Auth", "google"]
        }
      }
    },
    {
      "name": "3. [Authz Negative] Access Protected Endpoint Without Token (401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Request without Bearer token returns 401 Unauthorized\", function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ownerId\": \"00000000-0000-0000-0000-000000000000\",\n  \"title\": \"Unauthorized Property\",\n  \"description\": \"Should be blocked\",\n  \"type\": 0,\n  \"pricePerMonth\": 10000,\n  \"areaSqM\": 40,\n  \"roomsCount\": 1,\n  \"latitude\": 50.45,\n  \"longitude\": 30.52,\n  \"address\": \"Test 1\",\n  \"city\": \"Київ\",\n  \"images\": []\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/Properties",
          "host": ["{{baseUrl}}"],
          "path": ["api", "Properties"]
        }
      }
    },
    {
      "name": "4. [Authz Negative] Access Protected Endpoint With Tampered JWT (401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Tampered/Invalid JWT token returns 401 Unauthorized\", function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.tampered.signature" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/Properties/11111111-1111-1111-1111-111111111111",
          "host": ["{{baseUrl}}"],
          "path": ["api", "Properties", "11111111-1111-1111-1111-111111111111"]
        }
      }
    },
    {
      "name": "5. [Auth Positive] Valid Login & JWT Token Structure Check (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Valid user login returns 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const data = pm.response.json();",
              "pm.test(\"Response contains valid 3-part JWT token and expiration\", function () {",
              "    pm.expect(data).to.have.property('token');",
              "    pm.expect(data.token.split('.').length).to.eql(3);",
              "    pm.expect(data).to.have.property('expiresAt');",
              "});",
              "",
              "pm.collectionVariables.set(\"jwt_token\", data.token);",
              "pm.collectionVariables.set(\"user_id\", data.userId);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{user_email}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/Auth/demo-login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "Auth", "demo-login"]
        }
      }
    },
    {
      "name": "6. [Authz Positive] Create Protected Resource With Valid JWT (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Authorized request with valid Bearer JWT succeeds (201 Created)\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const data = pm.response.json();",
              "pm.collectionVariables.set(\"temp_property_id\", data.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ownerId\": \"{{user_id}}\",\n  \"title\": \"QA3 Authz Check Property\",\n  \"description\": \"Temporary property to verify JWT authorization\",\n  \"type\": 0,\n  \"pricePerMonth\": 15000,\n  \"areaSqM\": 45,\n  \"roomsCount\": 1,\n  \"latitude\": 50.45,\n  \"longitude\": 30.52,\n  \"address\": \"вул. Володимирська, 10\",\n  \"city\": \"Київ\",\n  \"images\": []\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/Properties",
          "host": ["{{baseUrl}}"],
          "path": ["api", "Properties"]
        }
      }
    },
    {
      "name": "7. [Authz Business Rule] Owner Cannot Book Own Property (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Owner booking own property is forbidden by business rule (400)\", function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"propertyId\": \"{{temp_property_id}}\",\n  \"clientId\": \"{{user_id}}\",\n  \"startDate\": \"2026-12-01\",\n  \"endDate\": \"2026-12-05\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/Bookings",
          "host": ["{{baseUrl}}"],
          "path": ["api", "Bookings"]
        }
      }
    },
    {
      "name": "8. [Cleanup] Delete Temporary QA3 Property (204)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Cleanup succeeded (204 No Content)\", function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/Properties/{{temp_property_id}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "Properties", "{{temp_property_id}}"]
        }
      }
    }
  ]
}