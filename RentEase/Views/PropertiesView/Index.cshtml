@model IEnumerable<RentEase.Models.Property>

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <title>Каталог нерухомості</title>
    <style>
        body { font-family: sans-serif; margin: 2rem; color: #1f2937; }
        table { width: 100%; border-collapse: collapse; margin-top: 1rem; border: 1px solid #ccc; }
        th, td { border: 1px solid #ccc; padding: 10px; text-align: left; vertical-align: top; }
        th { background: #f4f4f4; }
        .btn { padding: 6px 12px; text-decoration: none; background: #2563eb; color: white; border-radius: 4px; display: inline-block; font-size: 14px; }
        .btn-success { background: #16a34a; }
        .btn-danger { background: #dc2626; border: none; color: white; padding: 6px 10px; cursor: pointer; border-radius: 4px; font-size: 14px; }
        .actions-cell { display: flex; gap: 8px; align-items: center; }
        .booking-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 4px; }
        .date-badge { display: inline-block; padding: 4px 8px; font-size: 12px; border-radius: 4px; background: #fee2e2; color: #991b1b; font-weight: 500; border: 1px solid #fecaca; }
        .empty-status { color: #16a34a; font-size: 13px; font-weight: 500; }
    </style>
</head>
<body>
    <h1>Каталог нерухомості</h1>
    <a href="/PropertiesView/Create" class="btn">+ Додати новий об'єкт</a>

    <table>
        <thead>
            <tr>
                <th>Фото</th>
                <th>Назва</th>
                <th>Місто / Адреса</th>
                <th>Ціна / доба</th>
                <th>Кімнат</th>
                <th>Зайняті дати</th>
                <th>Дії</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var dailyRate = Math.Round(item.PricePerMonth / 30m, 2);
                <tr>
                    <td>
                        @if (item.Images.Any())
                        {
                            <a href="@item.Images.First().FileUrl" target="_blank">Переглянути фото</a>
                        }
                        else
                        {
                            <span style="color: #9ca3af;">Немає фото</span>
                        }
                    </td>
                    <td><strong>@item.Title</strong></td>
                    <td>@item.City, @item.Address</td>
                    <td>
                        <strong>@dailyRate грн</strong>
                        <div style="font-size: 12px; color: #6b7280;">(@item.PricePerMonth грн/міс)</div>
                    </td>
                    <td>@item.RoomsCount</td>
                    <td>
                        @if (item.Bookings != null && item.Bookings.Any())
                        {
                            <ul class="booking-list">
                                @foreach (var b in item.Bookings.OrderBy(b => b.StartDate))
                                {
                                    <li>
                                        <span class="date-badge">🔒 @b.StartDate.ToString("dd.MM.yyyy") – @b.EndDate.ToString("dd.MM.yyyy")</span>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <span class="empty-status">✓ Вільна для бронювання</span>
                        }
                    </td>
                    <td>
                        <div class="actions-cell">
                            <a href="/PropertiesView/Book/@item.Id" class="btn btn-success">Забронювати</a>
                            <form action="/PropertiesView/Delete/@item.Id" method="post" style="display:inline; margin: 0;">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn-danger" onclick="return confirm('Видалити?');">Видалити</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</body>
</html>