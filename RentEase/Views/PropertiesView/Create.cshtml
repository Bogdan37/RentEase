@model RentEase.Models.Property

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <title>Додати об'єкт — MVC (C1)</title>
    <style>
        body { font-family: sans-serif; margin: 2rem; max-width: 600px; }
        .form-group { margin-bottom: 1rem; }
        label { display: block; font-weight: bold; margin-bottom: 4px; }
        input, textarea, select { width: 100%; padding: 8px; box-sizing: border-box; }
        button { padding: 8px 16px; background: #16a34a; color: white; border: none; border-radius: 4px; cursor: pointer; }
        .error { color: red; margin-bottom: 1rem; }
    </style>
</head>
<body>
    <h2>Створення оголошення (C1)</h2>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="error">
            @foreach (var modelState in ViewData.ModelState.Values)
            {
                @foreach (var error in modelState.Errors)
                {
                    <p>⚠️ @error.ErrorMessage</p>
                }
            }
        </div>
    }

    <form action="/PropertiesView/Create" method="post">
        <div class="form-group">
            <label>Назва</label>
            <input name="Title" value="@Model?.Title" required />
        </div>
        <div class="form-group">
            <label>Тип нерухомості</label>
            <select name="Type">
                <option value="Apartment">Квартира (Apartment)</option>
                <option value="House">Будинок (House)</option>
                <option value="Studio">Студія (Studio)</option>
            </select>
        </div>
        <div class="form-group">
            <label>Опис</label>
            <textarea name="Description" rows="3">@Model?.Description</textarea>
        </div>
        <div class="form-group">
            <label>Місто</label>
            <input name="City" value="@(Model?.City ?? "Київ")" required />
        </div>
        <div class="form-group">
            <label>Адреса</label>
            <input name="Address" value="@Model?.Address" required />
        </div>
        <div class="form-group">
            <label>Ціна за місяць (грн)</label>
            <input name="PricePerMonth" type="number" step="0.01" value="@Model?.PricePerMonth" required />
        </div>
        <div class="form-group">
            <label>Площа (м²)</label>
            <input name="AreaSqM" type="number" step="0.1" value="@Model?.AreaSqM" required />
        </div>
        <div class="form-group">
            <label>Кількість кімнат</label>
            <input name="RoomsCount" type="number" value="@(Model?.RoomsCount ?? 1)" required />
        </div>
        <div class="form-group">
            <label>Посилання на зображення (файл)</label>
            <input type="url" name="imageUrl" placeholder="https://images.unsplash.com/..." required />
        </div>
        <button type="submit">Зберегти об'єкт</button>
        <a href="/PropertiesView" style="margin-left: 10px;">Назад</a>
    </form>
</body>
</html>